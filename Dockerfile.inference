FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      default-jre-headless \
      libgomp1 \
 && rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH \
    PYSPARK_PYTHON=/opt/venv/bin/python \
    JAVA_HOME=/usr/lib/jvm/default-java

WORKDIR /app

COPY requirements.inference.txt ./requirements.txt
RUN python -m venv "$VIRTUAL_ENV" \
 && python -m pip install --no-cache-dir --upgrade pip \
 && python -m pip install --no-cache-dir -r requirements.txt

# Cache Iceberg dependencies so Batch jobs do not need Maven access at startup.
RUN python - <<'EOF'
from pyspark.sql import SparkSession
ICEBERG_PKG = "org.apache.iceberg:iceberg-spark-runtime-4.0_2.13:1.10.0"
ICEBERG_AWS = "org.apache.iceberg:iceberg-aws-bundle:1.10.0"
spark = (SparkSession.builder
    .master("local[1]")
    .config("spark.jars.packages", f"{ICEBERG_PKG},{ICEBERG_AWS}")
    .getOrCreate())
spark.stop()
EOF

COPY src/ /app/src/
RUN mkdir -p /app/data/raw/ourairports \
 && python -c 'import urllib.request; urllib.request.urlretrieve("https://ourairports.com/data/airports.csv", "/app/data/raw/ourairports/airports.csv")'

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    OUTPUT_DIR=/app \
    PLANEQUERY_READ_FROM_S3=1

CMD ["python", "/app/src/data_engineering/flights/flights_from_model.py", "--help"]
