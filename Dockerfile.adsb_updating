FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install only the runtime dependencies needed by src/adsb/main.py.
RUN pip install --no-cache-dir \
    polars==1.38.1 \
    requests==2.32.5 \
    boto3==1.42.28

# Copy source code
COPY src/ src/

# Set environment variables from .env file
ENV PYTHONPATH=/app/src
ENV ENVIRONMENT=production

# ADS-B HTTP proxy. Publish this through an HTTPS reverse proxy or tunnel.
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1

# Run both the HTTP proxy and the existing S3 uploader.
CMD ["python", "src/adsb/main.py", "--write-to-s3"]
