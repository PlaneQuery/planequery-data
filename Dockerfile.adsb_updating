FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install only the runtime dependencies needed by src/adsb/main.py.
RUN pip install --no-cache-dir \
    polars==1.38.1 \
    requests==2.32.5 \
    boto3==1.42.28

# Copy source code
COPY src/ src/

# Set environment variables from .env file
ENV PYTHONPATH=/app
ENV ENVIRONMENT=production

# Expose any ports if needed (optional, remove if not applicable)
# EXPOSE 8000

# Run the ADS-B main script
CMD ["python", "src/adsb/main.py", "--write-to-s3"]
